# Copy to backend/.env and fill in. backend/.env is gitignored.
# Get a key at https://build.nvidia.com (any model page -> "Get API Key").
NVIDIA_API_KEY=
# Optional: any chat model id from build.nvidia.com
# NIM_MODEL=meta/llama-3.3-70b-instruct

# Optional: reliable web search for the research agent (free 1,000 searches/month at tavily.com).
# Without it the agent uses free ddgs search, which search engines sometimes block.
TAVILY_API_KEY=
